{
  "name": "dsh-omp-tui",
  "description": "OMP-styled interactive terminal profile bundle for DeepSeek Harness",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mytianyi0712/dsh-tui-plugin-OhMyPi.git"
  },
  "homepage": "https://github.com/mytianyi0712/dsh-tui-plugin-OhMyPi#readme",
  "bugs": {
    "url": "https://github.com/mytianyi0712/dsh-tui-plugin-OhMyPi/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "terminal-ui",
    "tui",
    "omp"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-transform-types \"tests/*.spec.ts\"",
    "check": "npm run verify:boundary && npm run verify:contract && npm run verify:patch-surface && npm run verify:plugin-spec && npm run typecheck && npm run test",
    "generate:themes": "node scripts/generate-omp-themes.mjs",
    "build": "npm run verify:boundary && npm run verify:contract && npm run verify:patch-surface && npm run verify:plugin-spec && tsc -b && tsdown",
    "prepare": "tsdown --config tsdown.prepare.config.ts",
    "verify:boundary": "node scripts/verify-boundary.ts",
    "verify:contract": "node scripts/verify-contract.ts",
    "verify:plugin-spec": "node scripts/verify-plugin-spec.ts",
    "verify:patch-surface": "node scripts/verify-patch-surface.ts"
  },
  "main": "lib/index.js",
  "bin": {
    "omdsh": "scripts/omdsh.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./startup": "./lib/startup.js",
    "./prompt": "./lib/prompt.js",
    "./session-title": "./lib/session-title.js",
    "./session-persistence": "./lib/session-persistence.js",
    "./wechat": "./lib/wechat/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./plugin-host": "./lib/host/plugin-host.js",
    "./plugin-storage": "./lib/host/plugin-storage.js",
    "./message-observer": "./lib/host/message-observer.js",
    "./effect-ledger": "./lib/host/effect-ledger.js",
    "./std-adapter": "./lib/dsh-adapter/std-adapter.js",
    "./std-profile-loader": "./lib/dsh-adapter/std-profile-loader.js"
  },
  "files": [
    "CHANGELOG.md",
    "docs/INSTALL.md",
    "lib/*.js",
    "lib/wechat",
    "lib/host",
    "lib/dsh-adapter",
    "patches",
    "scripts/omdsh",
    "scripts/omdsh.cmd",
    "scripts/omdsh.js",
    "src",
    "cordis.patch.yml",
    "dsh-plugin.json"
  ],
  "license": "BSD-3-Clause",

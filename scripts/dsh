#!/usr/bin/env bash
# dsh wrapper: a bare `dsh` boots the omp-styled tui profile by default.
# Real dsh invocations (web/plugin/--profile/--patch/--dump*/help/version)
# pass through unchanged. Put this script's directory first on PATH, or
# alias dsh=<path-to-this-script>.
#
# Backend resolution order: $DSH_REAL (explicit executable) → a global `dsh`
# on PATH (outside this wrapper's own directory) → a globally installed
# @deepseek-ai/dsh → `npx --yes @deepseek-ai/dsh`.
# Set DSH_DEBUG=1 to print the resolved command instead of running it.
set -u

run_dsh() {
  if [[ "${DSH_DEBUG:-}" == "1" ]]; then
    printf 'dsh wrapper → %s\n' "$*"
    return 0
  fi
  exec "$@"
}

real_dsh() {
  if [[ -n "${DSH_REAL:-}" ]]; then
    run_dsh "${DSH_REAL}" "$@"
    return
  fi
  local resolved
  if resolved="$(command -v dsh 2>/dev/null)" && [[ -n "${resolved}" ]]; then
    # Skip ourselves when the wrapper directory shadows the real binary.
    local wrapper_dir resolved_dir
    wrapper_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    resolved_dir="$(cd "$(dirname "${resolved}")" && pwd)"
    if [[ "${resolved_dir}" != "${wrapper_dir}" ]]; then
      run_dsh "${resolved}" "$@"
      return
    fi
  fi
  # A globally installed dsh, when present.
  local global_bin
  global_bin="$(npm root -g 2>/dev/null)/@deepseek-ai/dsh/lib/bin.js"
  if [[ -f "${global_bin}" ]]; then
    run_dsh node "${global_bin}" "$@"
    return
  fi
  run_dsh npx --yes @deepseek-ai/dsh "$@"
}

first="${1:-}"
case "${first}" in
  web | plugin | --profile | --patch | --dump-config | --dump-default-config | -V | --version | -h | --help)
    real_dsh "$@"
    ;;
  *)
    real_dsh --profile tui "$@"
    ;;
esac
